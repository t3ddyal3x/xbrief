# xbrief's front door: the app on 127.0.0.1:8795. Pasted into /opt/homebrew/etc/Caddyfile by bin/install-agent,
# ABOVE the catch-all, beside the other apps' blocks (it replaces the block of the static-page build).
# `import loopback_only` FIRST (see the guard's comment at the top of the Caddyfile).
http://xbrief.localhost {
	import loopback_only
	route {
		reverse_proxy 127.0.0.1:8795
	}
}
