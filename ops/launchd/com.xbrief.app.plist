<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.xbrief.app</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/bin/xbrief</string>
    <string>serve</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>PYTHONUNBUFFERED</key><string>1</string>
  </dict>
  <!-- Always on, like the other pages: the app at xbrief.localhost (port 8795) and the schedule, which is set on
       the page (History → Schedule) and starts each run as its own process. A run is left to finish when the app
       restarts (AbandonProcessGroup), so a read is never cut off with its Brave open. -->
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>AbandonProcessGroup</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>__DATA__/logs/app.log</string>
  <key>StandardErrorPath</key><string>__DATA__/logs/app.log</string>
  <!-- Interactive: without it launchd runs the server at utility priority (pri 20, often the efficiency cores)
       and every page and cache rebuild took 2-4x longer (work/portmantou/docs/reviews/efficiency-portmantou-2026-10-20.md). -->
  <key>ProcessType</key><string>Interactive</string>
</dict>
</plist>
