#!/usr/bin/env bash
# Install the Caddy front door (http://xbrief.localhost → ~/Data/xbrief-data/briefs) and the two LaunchAgents.
#   bin/install-agent          both
#   bin/install-agent --page   the front door only (before the first hand run is checked)
# Idempotent. The Caddyfile is shared by every app: back it up, insert one block above the catch-all, VALIDATE
# before reloading, restore the backup if validation fails (macro's script).
set -euo pipefail
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$REPO/bin/_env"
DATA="${XBRIEF_DATA_DIR:-$HOME/Data/xbrief-data}"
AGENTS="$HOME/Library/LaunchAgents"
CADDYFILE="/opt/homebrew/etc/Caddyfile"
mkdir -p "$DATA/logs" "$DATA/briefs"
chmod 700 "$DATA"

if grep -q "http://xbrief.localhost" "$CADDYFILE"; then
  echo "caddy: xbrief.localhost already present — left as is"
else
  backup="$CADDYFILE.bak-$(date +%Y-%m-%d-%H%M%S)-xbrief"
  cp "$CADDYFILE" "$backup"
  "$PY" - "$CADDYFILE" "$REPO/ops/caddy/xbrief.caddy" "$DATA" <<'PYEOF'
import sys, pathlib
cf, block, data = pathlib.Path(sys.argv[1]), pathlib.Path(sys.argv[2]).read_text(), sys.argv[3]
s = cf.read_text()
anchor = "# Catch-all."
if anchor not in s:
    sys.exit("catch-all anchor not found; not editing the Caddyfile")
new = s.replace(anchor, block.replace("__DATA__", data) + "\n" + anchor, 1)
tmp = cf.with_name(cf.name + ".part")
tmp.write_text(new)
tmp.replace(cf)
PYEOF
  if caddy validate --config "$CADDYFILE" --adapter caddyfile >/dev/null 2>&1; then
    caddy reload --config "$CADDYFILE" --adapter caddyfile
    echo "caddy: xbrief.localhost added (backup $backup)"
  else
    cp "$backup" "$CADDYFILE"
    echo "caddy: validation FAILED — Caddyfile restored from $backup" >&2
    exit 1
  fi
fi

[ "${1:-}" = "--page" ] && exit 0

for label in com.xbrief.am com.xbrief.pm; do
  sed -e "s#__REPO__#$REPO#g" -e "s#__DATA__#$DATA#g" "$REPO/ops/launchd/$label.plist" > "$AGENTS/$label.plist"
  plutil -lint "$AGENTS/$label.plist" >/dev/null
  launchctl bootout "gui/$(id -u)/$label" 2>/dev/null || true
  for _ in $(seq 1 50); do launchctl print "gui/$(id -u)/$label" >/dev/null 2>&1 || break; sleep 0.1; done
  ok=""
  for _ in 1 2 3; do
    if launchctl bootstrap "gui/$(id -u)" "$AGENTS/$label.plist" 2>/dev/null; then ok=1; break; fi
    sleep 1
  done
  [ -n "$ok" ] || { echo "agent: $label FAILED to load" >&2; exit 1; }
  echo "agent: $label loaded"
done
